# 可选：首次启动时自动创建 OpenAI 供应商，也可留空后在管理后台添加
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_ENABLED=true
DATABASE_PATH=/data/gateway.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOWED_PATH_PREFIXES=responses,chat/completions,embeddings,models,moderations,images,audio
DEFAULT_RPM=30
REQUEST_TIMEOUT_SECONDS=180
DETAILED_LOGGING_ENABLED=true
DETAILED_LOG_RETENTION_DAYS=7
DETAILED_LOG_MAX_BYTES=65536
CODEX_LOG_MAX_BYTES=33554432
CODEX_LOG_RETENTION_DAYS=90
DEFAULT_TOKEN_RESERVATION=2048
ALLOW_INSECURE_UPSTREAMS=false
